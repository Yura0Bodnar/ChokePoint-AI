# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=stub           # hf | local | stub — real values arrive with P2's PR
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_INFERENCE_PROVIDER=auto
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=3

# ── Graph ────────────────────────────────────────────────────────────
GRAPH_BACKEND=networkx      # networkx | kuzu — real values arrive with P1's PR
GRAPH_SEED_DIR=src/chokepoint/graph/seed
SIM_MAX_HOPS=4
SIM_DECAY=0.75
SIM_MIN_IMPACT=0.02

# ── Ingestion ────────────────────────────────────────────────────────
GDELT_TIMESPAN=24h
GDELT_MAX_RECORDS=75
RSS_FEEDS_FILE=src/chokepoint/ingestion/feeds.yaml

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
DEMO_MODE=false              # true = stub provider + cached feed, for offline demos
