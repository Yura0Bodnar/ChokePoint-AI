# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=stub           # hf | local | stub — real values arrive with P2's PR
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HF_MODEL=openai/gpt-oss-20b        # fastest measured (0.6 s, json_object) — see docs/PROMPTS.md §3; Llama-3.1-8B-Instruct also works (3.6 s)
HF_INFERENCE_PROVIDER=auto  # or a named provider (hf-inference, together, …); base_url is code-only
# Do NOT set HF_HUB_OFFLINE=1 in the shell that runs the service: it blocks every HF call.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=3
LLM_FAILOVER_TO_LOCAL=true   # hf → local CPU model automatically on 402 (credits) / network errors
LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # needs `uv sync --group local`; ~3 GB of weights on first run
LOCAL_DEVICE=cpu             # cpu | mps (Apple Silicon) | cuda

# ── Graph ────────────────────────────────────────────────────────────
GRAPH_BACKEND=networkx      # networkx | kuzu — real values arrive with P1's PR
GRAPH_SEED_DIR=src/chokepoint/graph/seed
SIM_MAX_HOPS=4
SIM_DECAY=0.75
SIM_MIN_IMPACT=0.02

# ── Ingestion ────────────────────────────────────────────────────────
GDELT_TIMESPAN=24h
GDELT_MAX_RECORDS=75
RSS_FEEDS_FILE=src/chokepoint/ingestion/feeds.yaml

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
DEMO_MODE=false              # true = stub provider + cached feed, for offline demos
