# Copy to .env (cp .env.example .env). Defaults run fully offline: no token, no network.

# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=stub           # stub (offline, canned event) | hf (Hugging Face Inference API) | local (CPU model)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx   # only needed for LLM_PROVIDER=hf — https://hf.co/settings/tokens
HF_MODEL=openai/gpt-oss-20b        # must be served by a free-tier Inference Provider — see docs/PROMPTS.md §3 (Qwen2.5-7B/1.5B and Mistral-Nemo are not)
HF_INFERENCE_PROVIDER=auto  # or a named provider (hf-inference, together, …)
# Do NOT set HF_HUB_OFFLINE=1 in the shell that runs the service: it blocks every HF call.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=3           # total provider attempts per extraction (each one is a billed HF call)
LLM_FAILOVER_TO_LOCAL=true   # when HF fails the UI offers to run the local CPU model (needs the `local` dependency group)
LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # ~3 GB of weights on first use; cached in the `hf-cache` docker volume
LOCAL_DEVICE=cpu             # cpu | mps (Apple Silicon) | cuda

# ── Graph ────────────────────────────────────────────────────────────
GRAPH_BACKEND=networkx      # only "networkx" is implemented
SIM_MAX_HOPS=4
SIM_DECAY=0.75
SIM_MIN_IMPACT=0.02

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
DEMO_MODE=false              # true = canned 3-hop graph cascade instead of the real graph (offline demos)
